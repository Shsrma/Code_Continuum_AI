# Code Continuum AI — Environment Configuration Example

# Environment Mode
ENVIRONMENT=development
DEBUG=True

# API Configuration
PROJECT_NAME="Code Continuum AI API"
VERSION="0.1.0"
API_V1_STR="/api/v1"
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]

# Database Connection (Default: SQLite for local zero-dependency development/testing)
DATABASE_URL=sqlite:///./code_continuum_dev.db
# PostgreSQL with pgvector (Uncomment for Docker / Production)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/code_continuum_db

# Redis Connection
REDIS_URL=redis://localhost:6379/0

# Security Keys
JWT_SECRET=dev-insecure-secret-key-change-in-production-32bytes!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Provider Configuration (Optional for initial MVP foundation)
AI_PROVIDER=mock
OPENAI_API_KEY=your-openai-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here
